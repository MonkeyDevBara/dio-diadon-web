# Salin ke .env untuk pengembangan lokal. Di Vercel, isi di Project Settings > Environment Variables.

# Wajib untuk /admin (minimal 8 karakter).
ADMIN_PASSWORD=

# Produksi: database Turso. Kosongkan di lokal (otomatis memakai file ./data/dio.db).
# TURSO_DATABASE_URL=libsql://nama-db-akun.turso.io
# TURSO_AUTH_TOKEN=
