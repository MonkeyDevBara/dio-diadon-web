---
import { videos } from '../data/site';
---

<section id="video" class="bg-grape/15 py-16">
  <div class="mx-auto max-w-5xl px-5">
    <div class="text-center">
      <h2 class="bubble text-2xl sm:text-4xl">Yang paling sering ditonton</h2>
    </div>

    <ul class="mt-14 grid grid-cols-2 gap-4 sm:gap-6 lg:grid-cols-4">
      {videos.map((v, i) => (
        <li class="reveal" style={`--i:${i}`}>
          <a href={v.url} target="_blank" rel="noopener" class="tilt group block" style={`--r:${i % 2 ? 2 : -2}deg`}>
            <div class={`relative aspect-[9/16] overflow-hidden rounded-md border-2 border-ink bg-gradient-to-br ${v.grad} shadow-[4px_4px_0_#151515]`}>
              <span class="mono absolute left-2 top-2 rounded bg-white/90 px-1.5 py-0.5 text-[0.55rem]">thumbnail dummy</span>
              <span class="absolute inset-0 grid place-items-center">
                <span class="grid h-14 w-14 place-items-center rounded-full bg-white/90 text-xl transition-transform group-hover:scale-110" aria-hidden="true">▶</span>
              </span>
              <span class="mono absolute bottom-2 left-2 rounded bg-ink px-2 py-1 text-[0.65rem] text-white">👁 {v.views}</span>
            </div>
            <p class="mt-3 text-sm font-extrabold leading-snug">{v.title}</p>
            <p class="hand mt-1 text-lg leading-tight text-ink/70">“{v.quote.text}” <span class="mono text-[0.55rem]">@{v.quote.author}</span></p>
            <span class="sr-only">(buka di Instagram, tab baru)</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
