---
import { nav } from '../data/static';
---

<header class="sticky top-3 z-50 px-3 no-print">
  <nav
    aria-label="Navigasi utama"
    class="mx-auto flex max-w-3xl items-center gap-1 rounded-xl border-2 border-ink bg-white p-1 shadow-[3px_3px_0_#151515]"
  >
    <a href="#beranda" class="mr-1 grid h-9 w-9 shrink-0 place-items-center rounded-lg bg-dio pixel text-lg" aria-label="Dio Diadon, ke atas">D</a>
    <ul id="nav-links" class="flex min-w-0 flex-1 items-center gap-1 overflow-x-auto [scrollbar-width:none]">
      {
        nav.map((n) => (
          <li class="shrink-0">
            <a
              href={n.href}
              data-nav
              class="mono flex items-center gap-1.5 rounded-lg px-2.5 py-2 text-[0.68rem] transition-colors hover:bg-sun/60 aria-[current=true]:bg-sun sm:px-3 sm:text-xs"
            >
              <span aria-hidden="true">{n.icon}</span>
              {n.label}
            </a>
          </li>
        ))
      }
    </ul>
    <a href="#undang" class="mono shrink-0 rounded-lg border-2 border-ink bg-ink px-3 py-2 text-[0.68rem] text-white hover:bg-dio hover:text-ink sm:text-xs">
      ✉ Undang Dio
    </a>
  </nav>
</header>

<script>
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-nav]')];
  const targets = links
    .map((a) => document.querySelector(a.getAttribute('href')!))
    .filter((el): el is Element => !!el);

  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        for (const a of links) {
          const on = a.getAttribute('href') === '#' + e.target.id;
          a.setAttribute('aria-current', String(on));
          if (on) {
            const box = a.closest('ul')!;
            const r = a.getBoundingClientRect(), b = box.getBoundingClientRect();
            box.scrollTo({ left: box.scrollLeft + r.left - b.left - (box.clientWidth - r.width) / 2, behavior: 'smooth' });
          }
        }
      }
    },
    { rootMargin: '-35% 0px -55% 0px' },
  );
  targets.forEach((t) => io.observe(t));
</script>
