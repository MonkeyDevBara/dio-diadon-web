  <p class="pixel text-3xl text-sun">DIO DIADON</p>
  <p class="hand mt-1 text-xl text-white/70">{site.tagline}</p>
  <p class="mono mt-6 text-[0.65rem] text-white/50">
    Part of Real Masjid Official · © {new Date().getFullYear()} Dio Diadon
  </p>
</footer>
