---
import { testimonials } from '../data/site';
---

<section id="kata-mereka" class="mx-auto max-w-5xl px-5 py-16">
  <h2 class="pixel text-center text-3xl sm:text-4xl">Kata mereka</h2>
  <ul class="mt-10 grid gap-8 md:grid-cols-3">
    {testimonials.map((t, i) => (
      <li class="reveal" style={`--i:${i}`}>
        <blockquote class="note tape tilt h-full !text-[1.35rem] !leading-snug" style={`--bg:${t.tint};--r:${t.rot}deg;--tape:rgb(255 255 255 / .6)`}>
          <p>“{t.text}”</p>
          <footer class="mt-3 !font-sans text-sm font-bold">
            {t.who}
            <span class="mono block text-[0.6rem] font-normal opacity-60">{t.org}</span>
          </footer>
        </blockquote>
      </li>
    ))}
  </ul>
  <p class="hand mt-6 text-center text-lg text-ink/50">*testimoni dummy</p>
</section>
