---
import { site } from '../data/site';
const { socials } = site;
const links = [
  { href: socials.instagram, label: 'Instagram', handle: '@diodiadon' },
  { href: socials.stdforyou, label: 'Instagram Starday', handle: '@stdforyou' },
  { href: socials.realmasjid, label: 'Real Masjid', handle: '@realmasjid.official' },
  { href: socials.threads, label: 'Threads', handle: '@diodiadon' },
];
---

<section id="komunitas" class="mx-auto max-w-5xl px-5 py-16">
  <div class="grid items-stretch gap-8 md:grid-cols-[1.2fr_1fr]">
    <a
      href={socials.telegram}
      target="_blank"
      rel="noopener"
      class="tape tilt relative block bg-sun p-7 shadow-[6px_6px_0_rgb(0_0_0/.15)]"
      style="--r:-1.5deg;--tape:rgb(122 170 255 / .6)"
    >
      <span class="tab-label bg-ink text-white">KOMUNITAS</span>
      <h2 class="mt-3 text-4xl font-extrabold leading-none text-navy sm:text-5xl">Rest Area</h2>
      <p class="mt-3 max-w-sm leading-relaxed">
        Ruang ngobrol di Telegram buat yang capek dan butuh tempat singgah. Ada ngaji ringan, curhat, dan info jadwal Starday.
      </p>
      <span class="mono mt-5 inline-block border-b-2 border-ink pb-0.5 text-xs font-bold">Gabung di Telegram ↗</span>
    </a>

    <div>
      <h3 class="pixel text-2xl">Ikuti terus</h3>
      <ul class="mt-4 space-y-3">
        {links.map((l, i) => (
          <li>
            <a href={l.href} target="_blank" rel="noopener" class="tilt flex items-center justify-between border-2 border-ink bg-white px-4 py-3 shadow-[3px_3px_0_#151515]" style={`--r:${i % 2 ? 1 : -1}deg`}>
              <span class="font-bold">{l.label}</span>
              <span class="mono text-[0.7rem] text-ink/60">{l.handle} ↗</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
